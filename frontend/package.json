{
  "name": "zhihu-learning-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && node scripts/check-visuals.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "fonts:prepare": "node scripts/prepare-fonts.mjs",
    "predev": "npm run fonts:prepare",
    "prebuild": "npm run fonts:prepare",
    "test:regressions": "node --test scripts/regressions.test.mjs",
    "test:loading": "node --test scripts/loading-controller.test.mjs",
    "test:resource-math": "node --experimental-strip-types --test scripts/resource-math.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@vitejs/plugin-react": "latest",
    "antd": "^6.6.3",
    "katex": "^0.18.7",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/katex": "^0.16.8",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
